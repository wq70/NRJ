{
  "id": "/",
  "name": "Clingy OS",
  "short_name": "Clingy OS",
  "description": "Clingy OS: 安装到主屏幕，像原生应用一样使用。",
  "lang": "zh-CN",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7e7ef",
  "theme_color": "#f7e7ef",
  "share_target": {
    "action": "/?delivery-share=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "video/*", "audio/*", "text/*", "application/pdf", "application/epub+zip", "application/json", "application/zip", ".nrjdrop", ".nrjbubble"]
        }
      ]
    }
  },
  "icons": [
    { "src": "/pwa-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/pwa-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/pwa-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
