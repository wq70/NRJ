# Gateway secrets belong only on the server. Do not put them in VITE_* or browser settings.
DATABASE_URL=postgresql://commerce:change-this-password@postgres:5432/commerce
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
COMMERCE_ENCRYPTION_KEY=
# Generate a hash with npm run password. This is a service account, not a platform account.
COMMERCE_USERS=[{"id":"your-user","name":"我的共逛","passwordHash":"replace-with-scrypt-hash"}]
COMMERCE_ALLOWED_ORIGINS=https://your-nrj-site.example
COMMERCE_MAX_SESSIONS=8
COMMERCE_IDLE_MINUTES=15
COMMERCE_COOKIE_SAMESITE=Lax
HOST=0.0.0.0
PORT=8790
